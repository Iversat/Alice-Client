# Copy to .env if configuring manually. yandex_login.py creates .env after login.
# The CLI reads .env in the current directory; process environment takes priority.
# Never commit real credentials. --anonymous ignores all tokens.
YANDEX_OAUTH_TOKEN=
YANDEX_ASR_KEY=
YANDEX_CLIENT_ID=
# Only if required by your registered OAuth application:
YANDEX_CLIENT_SECRET=
YANDEX_REFRESH_TOKEN=
YANDEX_TOKEN_EXPIRES_AT=
YANDEX_TOKEN_SCOPE=
